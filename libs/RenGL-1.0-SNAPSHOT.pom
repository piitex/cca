<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.piitex.engine</groupId>
    <artifactId>RenGL</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <lwjgl.version>3.4.3</lwjgl.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <skiko.version>0.150.1</skiko.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    </properties>

    <profiles>
        <profile>
            <id>lwjgl-natives-linux-amd64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
                <!-- Lets a release build (-DskipAutoNatives) select one platform explicitly via -P without this auto-detected profile also activating and fighting over lwjgl.natives. -->
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-linux</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.jetbrains.skiko</groupId>
                    <artifactId>skiko-awt-runtime-linux-x64</artifactId>
                    <version>${skiko.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>lwjgl-natives-linux-aarch64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-linux-arm64</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.jetbrains.skiko</groupId>
                    <artifactId>skiko-awt-runtime-linux-arm64</artifactId>
                    <version>${skiko.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>lwjgl-natives-macos-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-vulkan</artifactId>
                    <classifier>natives-macos</classifier>
                </dependency>
                <dependency>
                    <groupId>org.jetbrains.skiko</groupId>
                    <artifactId>skiko-awt-runtime-macos-x64</artifactId>
                    <version>${skiko.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>lwjgl-natives-macos-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-vulkan</artifactId>
                    <classifier>natives-macos-arm64</classifier>
                </dependency>
                <dependency>
                    <groupId>org.jetbrains.skiko</groupId>
                    <artifactId>skiko-awt-runtime-macos-arm64</artifactId>
                    <version>${skiko.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>lwjgl-natives-windows-amd64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-windows</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.jetbrains.skiko</groupId>
                    <artifactId>skiko-awt-runtime-windows-x64</artifactId>
                    <version>${skiko.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>lwjgl-natives-windows-aarch64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-windows-arm64</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.jetbrains.skiko</groupId>
                    <artifactId>skiko-awt-runtime-windows-arm64</artifactId>
                    <version>${skiko.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <!--
          The six profiles above resolve natives for whichever platform is BUILDING this
          project: fine for local dev/running the Demo, but useless to a downstream
          consumer. Maven does not evaluate a dependency's own <profiles> when another
          project just adds <dependency>RenGL</dependency>, so none of that activation
          logic reaches them.

          The six profiles below are the actual release mechanism: each is manually
          activated (via -P), pulls in exactly one platform's LWJGL + Skiko native
          artifacts unconditionally, and shades ONLY those (no RenGL classes, no LWJGL
          or Skiko API classes; consumers already get those transitively from the plain
          RenGL dependency) into one small jar attached to this same project's
          groupId:artifactId:version under a "natives-<platform>" classifier, matching
          LWJGL's own naming convention. A consumer targeting one platform adds two
          dependencies: the plain RenGL jar, plus this classifier for their platform,
          instead of hand-declaring every individual LWJGL native module themselves.

          Each one sets lwjgl.natives itself (reusing the SAME property the six dev
          profiles use, just to a fixed value instead of an OS-detected one) so the big
          unconditional ${lwjgl.natives}-classified dependency list further down doesn't
          need duplicating per platform. Because of that shared property, these can't be
          combined in one -P list (whichever profile's value "wins" would silently apply
          to all of them); run one platform per invocation instead, and pass
          -DskipAutoNatives so the host machine's own OS-detected dev profile doesn't
          also activate and contend for the same property:
            mvn -DskipAutoNatives -P natives-bundle-linux-amd64 package
            mvn -DskipAutoNatives -P natives-bundle-linux-aarch64 package
            mvn -DskipAutoNatives -P natives-bundle-macos-x86_64 package
            mvn -DskipAutoNatives -P natives-bundle-macos-aarch64 package
            mvn -DskipAutoNatives -P natives-bundle-windows-amd64 package
            mvn -DskipAutoNatives -P natives-bundle-windows-aarch64 package
          This only resolves and repackages already-published artifacts, so all six can
          be run from any single host OS: no cross-compilation, no target-platform
          execution needed.
        -->
        <profile>
            <id>natives-bundle-linux-amd64</id>
            <properties>
                <lwjgl.natives>natives-linux</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.jetbrains.skiko</groupId>
                    <artifactId>skiko-awt-runtime-linux-x64</artifactId>
                    <version>${skiko.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>${maven-shade-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>natives-bundle-linux-amd64</id>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <shadedArtifactAttached>true</shadedArtifactAttached>
                                    <shadedClassifierName>natives-linux</shadedClassifierName>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <artifactSet>
                                        <includes>
                                            <include>org.lwjgl:*:*:${lwjgl.natives}</include>
                                            <include>org.jetbrains.skiko:skiko-awt-runtime-linux-x64</include>
                                        </includes>
                                    </artifactSet>
                                    <filters>
                                        <filter>
                                            <artifact>me.piitex.engine:RenGL</artifact>
                                            <excludes>
                                                <exclude>**</exclude>
                                            </excludes>
                                        </filter>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <exclude>META-INF/MANIFEST.MF</exclude>
                                                <exclude>META-INF/INDEX.LIST</exclude>
                                                <exclude>META-INF/versions/**</exclude>
                                                <exclude>module-info.class</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>natives-bundle-linux-aarch64</id>
            <properties>
                <lwjgl.natives>natives-linux-arm64</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.jetbrains.skiko</groupId>
                    <artifactId>skiko-awt-runtime-linux-arm64</artifactId>
                    <version>${skiko.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>${maven-shade-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>natives-bundle-linux-aarch64</id>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <shadedArtifactAttached>true</shadedArtifactAttached>
                                    <shadedClassifierName>natives-linux-arm64</shadedClassifierName>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <artifactSet>
                                        <includes>
                                            <include>org.lwjgl:*:*:${lwjgl.natives}</include>
                                            <include>org.jetbrains.skiko:skiko-awt-runtime-linux-arm64</include>
                                        </includes>
                                    </artifactSet>
                                    <filters>
                                        <filter>
                                            <artifact>me.piitex.engine:RenGL</artifact>
                                            <excludes>
                                                <exclude>**</exclude>
                                            </excludes>
                                        </filter>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <exclude>META-INF/MANIFEST.MF</exclude>
                                                <exclude>META-INF/INDEX.LIST</exclude>
                                                <exclude>META-INF/versions/**</exclude>
                                                <exclude>module-info.class</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>natives-bundle-macos-x86_64</id>
            <properties>
                <lwjgl.natives>natives-macos</lwjgl.natives>
