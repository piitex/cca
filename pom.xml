<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.piitex.cca</groupId>
    <artifactId>cca</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Plain API jar, needed on every platform -->
        <dependency>
            <groupId>me.piitex.engine</groupId>
            <artifactId>RenGL</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- Extracting the downloaded llama.cpp release archives (.zip / .tar.gz). RenGL's
             download manager only transfers bytes; it does not unpack them. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.28.0</version>
        </dependency>

        <!-- Parsing the GitHub releases API response to find the right platform asset, and the
             JSON payload embedded in imported character/user cards. -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20250517</version>
        </dependency>

        <!-- Reading the PNG tEXt/EXIF metadata that SillyTavern- and BackyardAI-style character
             and user cards embed their data in. -->
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.19.0</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Builds the installer: ./mvnw clean package jpackage:jpackage
                     dmg on macOS, exe on Windows (jpackage cannot cross-compile, so build on each OS).
                     Add -Djpackage.type=app-image for a plain folder/.app with no installer tooling. -->
                <plugin>
                    <groupId>org.panteleyev</groupId>
                    <artifactId>jpackage-maven-plugin</artifactId>
                    <version>1.8.0</version>
                    <configuration>
                        <name>CCA</name>
                        <appVersion>1.0</appVersion>
                        <vendor>piitex</vendor>
                        <input>${project.build.directory}/jpackage-input</input>
                        <destination>${project.basedir}/dist</destination>
                        <mainJar>${project.artifactId}-${project.version}.jar</mainJar>
                        <mainClass>me.piitex.cca.Main</mainClass>
                        <addModules>
                            <addModule>java.base</addModule>
                            <addModule>java.desktop</addModule>
                            <addModule>java.instrument</addModule>
                            <addModule>java.logging</addModule>
                            <addModule>java.management</addModule>
                            <addModule>java.naming</addModule>
                            <addModule>java.net.http</addModule>
                            <addModule>java.sql</addModule>
                            <addModule>java.xml</addModule>
                            <addModule>jdk.management</addModule>
                            <addModule>jdk.unsupported</addModule>
                            <addModule>jdk.crypto.ec</addModule>
                        </addModules>
                        <javaOptions>
                            <javaOption>--enable-native-access=ALL-UNNAMED</javaOption>
                            <javaOption>--sun-misc-unsafe-memory-access=deny</javaOption>
                        </javaOptions>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Puts the app jar and every runtime dependency (including this OS's LWJGL natives,
                 picked by the profiles below) in one folder, which is what jpackage takes as input.
                 Run through package-windows.bat / package.sh rather than by hand. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- One runnable jar with everything in it, for java -jar target/cca-1.0-SNAPSHOT-all.jar.
                 It holds the LWJGL natives of the OS it was built on, so build it on each OS you want a jar for. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>runnable-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>me.piitex.cca.Main</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>rengl-natives-macos-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>me.piitex.engine</groupId>
                    <artifactId>RenGL</artifactId>
                    <version>1.0-SNAPSHOT</version>
                    <classifier>natives-macos-arm64</classifier>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <type>${jpackage.type}</type>
                            <javaOptions combine.children="append">
                                <javaOption>-XstartOnFirstThread</javaOption>
                            </javaOptions>
                            <destination/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <jpackage.type>DMG</jpackage.type>
            </properties>
        </profile>

        <profile>
            <id>rengl-natives-windows-amd64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>me.piitex.engine</groupId>
                    <artifactId>RenGL</artifactId>
                    <version>1.0-SNAPSHOT</version>
                    <classifier>natives-windows</classifier>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <type>${jpackage.type}</type>
                            <winMenu>true</winMenu>
                            <winShortcut>true</winShortcut>
                            <winDirChooser>true</winDirChooser>
                            <destination/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <jpackage.type>EXE</jpackage.type>
            </properties>
        </profile>

        <profile>
            <id>rengl-natives-linux-amd64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>me.piitex.engine</groupId>
                    <artifactId>RenGL</artifactId>
                    <version>1.0-SNAPSHOT</version>
                    <classifier>natives-linux</classifier>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <type>${jpackage.type}</type>
                            <destination/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <jpackage.type>DEB</jpackage.type>
            </properties>
        </profile>
        <!-- One runnable jar per OS from any machine: ./mvnw clean package -Pplatform-jars
             Writes app/dist/macos/cca-mac.jar, app/dist/linux/cca-linux.jar and app/dist/windows/cca-windows.jar next to their start scripts. Each one carries the natives for
             both x64 and arm64 of its OS. This only repackages the RenGL natives-* jars, so nothing runs on the target OS.
             jpackage installers can't be made this way, those still have to be built on their own OS. -->
        <profile>
            <id>platform-jars</id>
            <dependencies>
                <dependency>
                    <groupId>me.piitex.engine</groupId>
                    <artifactId>RenGL</artifactId>
                    <version>1.0-SNAPSHOT</version>
                    <classifier>natives-macos</classifier>
                </dependency>
                <dependency>
                    <groupId>me.piitex.engine</groupId>
                    <artifactId>RenGL</artifactId>
                    <version>1.0-SNAPSHOT</version>
                    <classifier>natives-macos-arm64</classifier>
                </dependency>
                <dependency>
                    <groupId>me.piitex.engine</groupId>
                    <artifactId>RenGL</artifactId>
                    <version>1.0-SNAPSHOT</version>
                    <classifier>natives-linux</classifier>
                </dependency>
                <dependency>
                    <groupId>me.piitex.engine</groupId>
                    <artifactId>RenGL</artifactId>
                    <version>1.0-SNAPSHOT</version>
                    <classifier>natives-linux-arm64</classifier>
                </dependency>
                <dependency>
                    <groupId>me.piitex.engine</groupId>
                    <artifactId>RenGL</artifactId>
                    <version>1.0-SNAPSHOT</version>
                    <classifier>natives-windows</classifier>
                </dependency>
                <dependency>
                    <groupId>me.piitex.engine</groupId>
                    <artifactId>RenGL</artifactId>
                    <version>1.0-SNAPSHOT</version>
                    <classifier>natives-windows-arm64</classifier>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>me.piitex.cca.Main</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                        <executions>
                            <!-- Replaced by the three jars below. -->
                            <execution>
                                <id>runnable-jar</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>jar-mac</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <outputFile>${project.basedir}/app/dist/macos/cca-mac.jar</outputFile>
                                    <artifactSet>
                                        <excludes>
                                            <exclude>org.lwjgl:*:jar:natives-*</exclude>
                                            <exclude>org.jetbrains.skiko:skiko-awt-runtime-*</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-linux</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-linux-arm64</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-windows</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-windows-arm64</exclude>
                                        </excludes>
                                    </artifactSet>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jar-linux</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <outputFile>${project.basedir}/app/dist/linux/cca-linux.jar</outputFile>
                                    <artifactSet>
                                        <excludes>
                                            <exclude>org.lwjgl:*:jar:natives-*</exclude>
                                            <exclude>org.jetbrains.skiko:skiko-awt-runtime-*</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-macos</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-macos-arm64</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-windows</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-windows-arm64</exclude>
                                        </excludes>
                                    </artifactSet>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jar-windows</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <outputFile>${project.basedir}/app/dist/windows/cca-windows.jar</outputFile>
                                    <artifactSet>
                                        <excludes>
                                            <exclude>org.lwjgl:*:jar:natives-*</exclude>
                                            <exclude>org.jetbrains.skiko:skiko-awt-runtime-*</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-macos</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-macos-arm64</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-linux</exclude>
                                            <exclude>me.piitex.engine:RenGL:jar:natives-linux-arm64</exclude>
                                        </excludes>
                                    </artifactSet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>