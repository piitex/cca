<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.piitex.cca</groupId>
    <artifactId>cca</artifactId>
    <version>1.0</version>

    <name>CCA</name>
    <description>Desktop app for chatting with AI characters, built on RenGL.</description>
    <url>https://github.com/piitex/cca</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/piitex/cca</url>
        <connection>scm:git:https://github.com/piitex/cca.git</connection>
    </scm>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <rengl.version>0.1.0</rengl.version>
    </properties>

    <dependencies>
        <!-- Plain API jar, needed on every platform -->
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-core</artifactId>
            <version>${rengl.version}</version>
        </dependency>

        <!-- The download manager and its progress UI, which moved out of rengl-core -->
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-downloads</artifactId>
            <version>${rengl.version}</version>
        </dependency>

        <!-- The Hunspell spelling checker the text areas use, which moved out of rengl-core -->
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-spellcheck</artifactId>
            <version>${rengl.version}</version>
        </dependency>

        <!-- Extracting the downloaded llama.cpp release archives (.zip / .tar.gz). RenGL's
             download manager only transfers bytes; it does not unpack them. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.28.0</version>
        </dependency>

        <!-- Parsing the GitHub releases API response to find the right platform asset, and the
             JSON payload embedded in imported character/user cards. -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20250517</version>
        </dependency>

        <!-- Reading the PNG tEXt/EXIF metadata that SillyTavern- and BackyardAI-style character
             and user cards embed their data in. -->
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.19.0</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
        </plugins>
    </build>

    <!-- RenGL's native libraries (LWJGL and Skia) come in a separate jar for each platform. The profile for the
         computer building the project switches on by itself. -->
    <profiles>
        <profile>
            <id>rengl-natives-macos-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-core</artifactId>
                    <version>${rengl.version}</version>
                    <classifier>natives-macos-arm64</classifier>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rengl-natives-macos-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-core</artifactId>
                    <version>${rengl.version}</version>
                    <classifier>natives-macos</classifier>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rengl-natives-windows-amd64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-core</artifactId>
                    <version>${rengl.version}</version>
                    <classifier>natives-windows</classifier>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rengl-natives-windows-aarch64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-core</artifactId>
                    <version>${rengl.version}</version>
                    <classifier>natives-windows-arm64</classifier>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rengl-natives-linux-amd64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-core</artifactId>
                    <version>${rengl.version}</version>
                    <classifier>natives-linux</classifier>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rengl-natives-linux-aarch64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-core</artifactId>
                    <version>${rengl.version}</version>
                    <classifier>natives-linux-arm64</classifier>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

</project>